# Template — copy to .env and fill in real values. (.env is gitignored.)

# ── Backend API base URL (THE single API variable — REQUIRED, fails fast) ──
# Server-only (never NEXT_PUBLIC_). Drives every API consumer:
# professionals, contact, blog, patient auth, practices.
WENAYA_API_URL=

# ── Admin (required for /admin auth) ───────────────────────────────────────
ADMIN_SECRET=

# ── CMS persistence (Upstash Redis) ────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Optional ───────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SITE_URL=https://www.wenaya.com
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_GSC_VERIFICATION=
# NEXT_PUBLIC_BING_VERIFICATION=
# ADMIN_SEED_USERNAME=
# ADMIN_SEED_PASSWORD=
# ADMIN_SEED_NAME=
